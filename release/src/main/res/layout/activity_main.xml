<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="#000000">

    <com.keyler.discoverykidschannel.AspectRatioFrameLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:id="@+id/videoContainer"
         android:layout_gravity="center">

        <!-- Release 2009.5.0.0: ya no es un <VideoView> fijo en XML. Se
             reemplaza en tiempo de ejecución por un DkVideoView (Release
             2009.5.2.1: envoltorio simple de VideoView clásico, el motor
             alternativo TextureView se eliminó) dentro de este mismo
             placeholder — ver LiveDiscoveryKids.onCreate().
             Release 5.4.1: este es el ÚNICO elemento que se achica y
             reposiciona dentro del recuadro de NextProgram — ver
             LiveDiscoveryKids.showVideoInBox(). El logo/marco (nextProgramBug,
             más abajo) vive en un AspectRatioFrameLayout APARTE que nunca se
             toca, para que no se achique junto con el video. -->
        <FrameLayout
             android:layout_height="match_parent"
             android:layout_width="wrap_content"
             android:id="@+id/videoViewContainer"
             android:layout_gravity="center" />

        <ImageView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:src="@drawable/screenbug"
             android:contentDescription="Channel watermark"
             android:alpha="0"
             android:id="@+id/screenBug" />

        <!-- Release 5.6.0 — BUG FIX ("el CRT de NextProgram afecta a VideoView"):
             antes había una SEGUNDA instancia de CrtOverlayView acá adentro
             (nextProgramCrtOverlay, agregada en la 5.5.0) — dos overlays
             animados corriendo en paralelo, cada uno con su propio loop de
             postInvalidateOnAnimation() por cuadro, el doble de carga de
             dibujo innecesaria en hardware limitado. Esa instancia (y la que
             vivía acá dentro de videoContainer) se eliminaron — ahora hay
             UNA sola, compartida, más abajo (ver el AspectRatioFrameLayout
             final de este archivo), dibujada por ENCIMA de todo (video +
             marco de NextProgram), en vez de duplicada. -->

    </com.keyler.discoverykidschannel.AspectRatioFrameLayout>

    <!-- Preview 2010.5.4.0.40: overlay "nextprogram" (GIF), reemplaza al
         enseguida post-programa.
         Release 5.4.1 — CORRECCIÓN (2 partes):
         1) Este GIF es el MARCO decorativo (logo, texto, el borde amarillo
            del recuadro) con el recuadro en sí TRANSPARENTE/vacío en el
            arte — lo que va DENTRO es el VIDEO del programa mismo, sin
            estirar (ver videoContainer arriba y
            LiveDiscoveryKids.showVideoInBox()/restoreVideoFullScreen()).
         2) Por eso NO puede vivir dentro de videoContainer (se achicaría
            junto con el video cuando este se reposiciona en el recuadro,
            arruinando el logo/texto que debe quedarse a tamaño completo).
            Va en su PROPIO AspectRatioFrameLayout, hermano de videoContainer
            — mismo criterio de altura → ancho×4/3 centrado, así queda
            siempre perfectamente alineado con el marco 4:3 del video
            (esté achicado o no), sin importar la proporción real de la
            pantalla del dispositivo. -->
    <com.keyler.discoverykidschannel.AspectRatioFrameLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:layout_gravity="center">

        <ImageView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:src="@drawable/nextprogram1"
             android:contentDescription="Next program frame"
             android:alpha="0"
             android:id="@+id/nextProgramBug" />

    </com.keyler.discoverykidschannel.AspectRatioFrameLayout>

    <!-- Release 5.6.0 — CrtOverlayView ÚNICA y compartida (ver comentario
         arriba). Hermana de videoContainer y del marco NextProgram, mismo
         AspectRatioFrameLayout 4:3 centrado que ambos — así el efecto CRT
         (scanlines, vignette, borde) queda perfectamente alineado tanto
         sobre el video como sobre el marco de NextProgram, sea cual sea el
         que esté visible en cada momento, con una sola animación. -->
    <com.keyler.discoverykidschannel.AspectRatioFrameLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:layout_gravity="center">

        <com.keyler.discoverykidschannel.CrtOverlayView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:clickable="false"
             android:focusable="false"
             android:id="@+id/crtOverlay" />

    </com.keyler.discoverykidschannel.AspectRatioFrameLayout>

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:gravity="center"
         android:alpha="0"
         android:fontFamily="@font/googlesans"
         android:textColor="#FFFFFF"
         android:id="@+id/debugInfo"
         android:layout_gravity="center|top"
         android:text="Espere..." />

    <ImageButton
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:visibility="gone"
         android:src="@drawable/btn_prev"
         android:background="@android:color/transparent"
         android:layout_marginStart="16dp"
         android:id="@+id/btnPrevious"
         android:layout_gravity="start|center_vertical" />

    <ImageButton
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:visibility="gone"
         android:src="@drawable/btn_next"
         android:layout_marginEnd="16dp"
         android:background="@android:color/transparent"
         android:id="@+id/btnNext"
         android:layout_gravity="end|center_vertical" />

    <ImageButton
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:visibility="gone"
         android:src="@drawable/btn_settings"
         android:layout_marginEnd="16dp"
         android:background="@android:color/transparent"
         android:layout_marginTop="16dp"
         android:id="@+id/btnSettings"
         android:layout_gravity="end|top" />

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:background="#000"
         android:fontFamily="@font/googlesans"
         android:id="@+id/versionInfo"
         android:text="..."
         android:layout_gravity="end|bottom" />

</FrameLayout>