<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="#000000">

    <com.keyler.discoverykidschannel.AspectRatioFrameLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:id="@+id/videoContainer"
         android:layout_gravity="center">

        <!-- Release 2009.5.0.0: ya no es un <VideoView> fijo en XML. Se
             reemplaza en tiempo de ejecución por un DkVideoView (Release
             2009.5.2.1: envoltorio simple de VideoView clásico, el motor
             alternativo TextureView se eliminó) dentro de este mismo
             placeholder — ver LiveDiscoveryKids.onCreate(). -->
        <FrameLayout
             android:layout_height="match_parent"
             android:layout_width="wrap_content"
             android:id="@+id/videoViewContainer"
             android:layout_gravity="center" />

        <ImageView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:src="@drawable/screenbug"
             android:contentDescription="Channel watermark"
             android:alpha="0"
             android:id="@+id/screenBug" />

        <com.keyler.discoverykidschannel.CrtOverlayView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:clickable="false"
             android:focusable="false"
             android:id="@+id/crtOverlay" />

    </com.keyler.discoverykidschannel.AspectRatioFrameLayout>

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:gravity="center"
         android:alpha="0"
         android:fontFamily="@font/googlesans"
         android:textColor="#FFFFFF"
         android:id="@+id/debugInfo"
         android:layout_gravity="center|top"
         android:text="Espere..." />

    <ImageButton
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:visibility="gone"
         android:src="@drawable/btn_prev"
         android:background="@android:color/transparent"
         android:layout_marginStart="16dp"
         android:id="@+id/btnPrevious"
         android:layout_gravity="start|center_vertical" />

    <ImageButton
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:visibility="gone"
         android:src="@drawable/btn_next"
         android:layout_marginEnd="16dp"
         android:background="@android:color/transparent"
         android:id="@+id/btnNext"
         android:layout_gravity="end|center_vertical" />

    <ImageButton
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:visibility="gone"
         android:src="@drawable/btn_settings"
         android:layout_marginEnd="16dp"
         android:background="@android:color/transparent"
         android:layout_marginTop="16dp"
         android:id="@+id/btnSettings"
         android:layout_gravity="end|top" />

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:background="#000"
         android:fontFamily="@font/googlesans"
         android:id="@+id/versionInfo"
         android:text="..."
         android:layout_gravity="end|bottom" />

</FrameLayout>