<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="#000000">

    <com.keyler.discoverykidschannel.AspectRatioFrameLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:id="@+id/videoContainer"
         android:layout_gravity="center">

        <!-- Release 2009.5.0.0: ya no es un <VideoView> fijo en XML. Se
             reemplaza en tiempo de ejecución por un DkVideoView (Release
             2009.5.2.1: envoltorio simple de VideoView clásico, el motor
             alternativo TextureView se eliminó) dentro de este mismo
             placeholder — ver LiveDiscoveryKids.onCreate(). -->
        <FrameLayout
             android:layout_height="match_parent"
             android:layout_width="wrap_content"
             android:id="@+id/videoViewContainer"
             android:layout_gravity="center" />

        <ImageView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:src="@drawable/screenbug"
             android:contentDescription="Channel watermark"
             android:alpha="0"
             android:id="@+id/screenBug" />

        <!-- Preview 2010.5.4.0.40: overlay "nextprogram" (GIF), reemplaza al
             enseguida post-programa.
             Release 5.4.0 — BUG FIX: antes era full-frame (match_parent),
             asumiendo que el GIF traía compuesto todo el frame. Confirmado en
             dispositivo que el asset real va POSICIONADO en el recuadro
             específico de la imagen de referencia (la esquina superior
             derecha, "cuadro rojo"), no a pantalla completa. Ahora se ubica
             con 4 guías porcentuales de ConstraintLayout calculadas sobre esa
             imagen de referencia (~46%–94% horizontal, ~9%–53% vertical del
             marco 4:3) en vez de match_parent. Si el arte final de Keyler
             termina teniendo otras proporciones, ajustar los 4
             layout_constraintGuide_percent de abajo. -->
        <androidx.constraintlayout.widget.ConstraintLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent">

            <androidx.constraintlayout.widget.Guideline
                 android:id="@+id/guideNextProgramStart"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:orientation="vertical"
                 app:layout_constraintGuide_percent="0.46" />

            <androidx.constraintlayout.widget.Guideline
                 android:id="@+id/guideNextProgramEnd"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:orientation="vertical"
                 app:layout_constraintGuide_percent="0.94" />

            <androidx.constraintlayout.widget.Guideline
                 android:id="@+id/guideNextProgramTop"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:orientation="horizontal"
                 app:layout_constraintGuide_percent="0.09" />

            <androidx.constraintlayout.widget.Guideline
                 android:id="@+id/guideNextProgramBottom"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:orientation="horizontal"
                 app:layout_constraintGuide_percent="0.53" />

            <ImageView
                 android:id="@+id/nextProgramBug"
                 android:layout_width="0dp"
                 android:layout_height="0dp"
                 android:scaleType="fitXY"
                 android:src="@drawable/nextprogram1"
                 android:contentDescription="Next program preview"
                 android:alpha="0"
                 app:layout_constraintStart_toStartOf="@id/guideNextProgramStart"
                 app:layout_constraintEnd_toEndOf="@id/guideNextProgramEnd"
                 app:layout_constraintTop_toTopOf="@id/guideNextProgramTop"
                 app:layout_constraintBottom_toBottomOf="@id/guideNextProgramBottom" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.keyler.discoverykidschannel.CrtOverlayView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:clickable="false"
             android:focusable="false"
             android:id="@+id/crtOverlay" />

    </com.keyler.discoverykidschannel.AspectRatioFrameLayout>

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:gravity="center"
         android:alpha="1"
         android:fontFamily="@font/googlesans"
         android:textColor="#FFFFFF"
         android:id="@+id/debugInfo"
         android:layout_gravity="center|top"
         android:text="Espere..." />

    <ImageButton
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:visibility="gone"
         android:src="@drawable/btn_prev"
         android:background="@android:color/transparent"
         android:layout_marginStart="16dp"
         android:id="@+id/btnPrevious"
         android:layout_gravity="start|center_vertical" />

    <ImageButton
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:visibility="gone"
         android:src="@drawable/btn_next"
         android:layout_marginEnd="16dp"
         android:background="@android:color/transparent"
         android:id="@+id/btnNext"
         android:layout_gravity="end|center_vertical" />

    <ImageButton
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:visibility="gone"
         android:src="@drawable/btn_settings"
         android:layout_marginEnd="16dp"
         android:background="@android:color/transparent"
         android:layout_marginTop="16dp"
         android:id="@+id/btnSettings"
         android:layout_gravity="end|top" />

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:background="#000"
         android:fontFamily="@font/googlesans"
         android:id="@+id/versionInfo"
         android:text="..."
         android:layout_gravity="end|bottom" />

</FrameLayout>