<!--
    activity_launcher.xml — Release 4.6.0

    Layout de DiscoveryKidsLauncherActivity ("Discovery Kids Launcher"):
    pantalla donde el usuario elige qué programas (pro1–pro4.mp4) quiere
    que salgan al aire. Calca al 100% el estilo de lista simple de
    activity_settings.xml (mismo header, mismo rótulo de sección gris,
    mismos ítems con switch a la derecha y descripción debajo) — se abre
    desde Configuración → "Elegir programas".
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dk_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ══ Header ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <ImageButton
                android:id="@+id/btnLauncherBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back"
                android:contentDescription="Volver" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Discovery Kids Launcher"
                android:textColor="@color/dk_text_primary"
                android:textSize="24sp"
                android:fontFamily="@font/googlesans" />
        </LinearLayout>

        <!-- ══ Sección: Programas ══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Programas"
            android:textColor="@color/dk_text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/googlesans"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elegí qué programas querés que salgan al aire en la programación. Los desactivados se saltean, igual que si el archivo no estuviera en Videos."
            android:textColor="@color/dk_text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/googlesans"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp" />

        <!-- Item: Programa 1 (switch) -->
        <LinearLayout
            android:id="@+id/itemProgram1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programa 1"
                    android:textColor="@color/dk_text_primary"
                    android:textSize="17sp"
                    android:fontFamily="@font/googlesans" />

                <TextView
                    android:id="@+id/txtProgram1Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comprobando…"
                    android:textColor="@color/dk_text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/googlesans"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchProgram1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dk_stroke" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />

        <!-- Item: Programa 2 (switch) -->
        <LinearLayout
            android:id="@+id/itemProgram2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programa 2"
                    android:textColor="@color/dk_text_primary"
                    android:textSize="17sp"
                    android:fontFamily="@font/googlesans" />

                <TextView
                    android:id="@+id/txtProgram2Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comprobando…"
                    android:textColor="@color/dk_text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/googlesans"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchProgram2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dk_stroke" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />

        <!-- Item: Programa 3 (switch) -->
        <LinearLayout
            android:id="@+id/itemProgram3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programa 3"
                    android:textColor="@color/dk_text_primary"
                    android:textSize="17sp"
                    android:fontFamily="@font/googlesans" />

                <TextView
                    android:id="@+id/txtProgram3Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comprobando…"
                    android:textColor="@color/dk_text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/googlesans"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchProgram3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dk_stroke" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />

        <!-- Item: Programa 4 (switch) -->
        <LinearLayout
            android:id="@+id/itemProgram4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programa 4"
                    android:textColor="@color/dk_text_primary"
                    android:textSize="17sp"
                    android:fontFamily="@font/googlesans" />

                <TextView
                    android:id="@+id/txtProgram4Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comprobando…"
                    android:textColor="@color/dk_text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/googlesans"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchProgram4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
