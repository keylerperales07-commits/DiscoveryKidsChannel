<!--
    activity_launcher.xml — Release 2009.5.1.0 ("Parque Imaginario"), 2009.5.2.1

    Rediseño a Material Design 3 puro:
      - Ya no hay un MenuBar custom (LinearLayout con degradado + logo +
        título hecho a mano) — la Activity ahora declara la ActionBar
        ORIGINAL de Android (Theme.Material3.DayNight, no NoActionBar — ver
        themes.xml). Release 2009.5.2.1: la ActionBar solo tiene el título
        (puesto por código en DiscoveryKidsLauncherActivity.onCreate()) — el
        logo se sacó de ahí y ahora vive en el cuerpo de la pantalla, entre
        la ActionBar y el botón "Iniciar canal" (ver @+id/imgLauncherLogo
        acá abajo). El botón de Configuración vive en el menú de overflow
        original de Android (menu_launcher.xml), no como ícono fijo.
      - "Iniciar canal" ahora es un MaterialButton relleno (estilo M3).
      - Colores: todo por atributos de tema (?attr/colorSurface,
        ?attr/colorOnSurface, etc.) en vez de los dk_* fijos — así el
        Launcher sigue el esquema claro/oscuro automáticamente (ver
        values/colors.xml y values-night/colors.xml).

    Release 5.6.0 — BUG FIX (malentendido de arquitectura, revertido): la
    5.5.0 había sacado ENTERA la sección "Programas" (cantidad + video de
    cada uno) de acá y la había metido dentro de ProgramConfigActivity junto
    con las opciones de cada programa y los ScreenBugs de eventos —
    equivocado. La separación real es:
      - LAUNCHER (acá): los PROGRAMAS en sí — cantidad y qué video es cada
        uno — y los ScreenBugs de eventos (Navidad, etc., son GLOBALES, no
        de un programa en particular).
      - Configuración de Programa (ProgramConfigActivity, un botón "⚙️ Opciones"
        por fila acá abajo): solo las OPCIONES de CADA programa (ya_regresa,
        continuamos, Intro, Créditos, A continuación personalizado, activar
        comerciales) — independientes entre sí, un programa no afecta a otro.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Logo — Release 2009.5.2.1: antes vivía en la ActionBar
             (setIcon/setDisplayUseLogoEnabled); ahora va acá, en el cuerpo,
             entre la ActionBar (que solo tiene el título) y el botón
             "Iniciar canal". -->
        <ImageView
            android:id="@+id/imgLauncherLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:contentDescription="Discovery Kids"
            android:src="@drawable/icon" />

        <!-- Botón principal: Iniciar canal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartChannel"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Iniciar canal"
            android:textSize="16sp"
            android:fontFamily="@font/dk_font"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart" />

        <!-- ══ Sección: ScreenBugs de eventos (Release 5.5.0, movida acá en
             la 5.6.0 — global, no es una opción de un programa en particular) ══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ScreenBugs de eventos"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/dk_font"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reemplazan el ScreenBug normal automáticamente en su fecha, si están activados."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:fontFamily="@font/dk_font"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            app:cardElevation="1dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Navidad (1 al 24 de diciembre)"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:fontFamily="@font/dk_font" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEventNavidad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Año Nuevo (25 de diciembre al 7 de enero)"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:fontFamily="@font/dk_font" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEventAnioNuevo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pascua (Domingo de Pascua)"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:fontFamily="@font/dk_font" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEventPascua"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Día de la Tierra (22 de abril)"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:fontFamily="@font/dk_font" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEventTierra"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══ Sección: Programas (Release 5.6.0 — de vuelta acá, ver
             comentario de arriba) ══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Programas"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/dk_font"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elegí el video de cada programa (ya no hace falta renombrarlo ni copiarlo a Videos). Para personalizar ya_regresa, continuamos, Intro, Créditos, A continuación o desactivar comerciales de un programa puntual, entrá a su ⚙️ Opciones."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:fontFamily="@font/dk_font"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp" />

        <!-- Item: Cantidad de programas (valor, abre diálogo 1–24) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            app:cardElevation="1dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant">

            <LinearLayout
                android:id="@+id/itemProgramCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cantidad de programas"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="17sp"
                    android:fontFamily="@font/dk_font" />

                <TextView
                    android:id="@+id/txtProgramCountValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 de 24 programas (Predeterminado: 4)"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:fontFamily="@font/dk_font"
                    android:layout_marginTop="2dp"
                    android:alpha="0.8" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Filas de programas: se agregan acá en código, una por programa
             (item_program_row.xml), ver DiscoveryKidsLauncherActivity.rebuildProgramList(). -->
        <LinearLayout
            android:id="@+id/containerPrograms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
