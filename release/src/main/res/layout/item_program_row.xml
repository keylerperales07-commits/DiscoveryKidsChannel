<!--
    item_program_row.xml — Release 5.6.0

    Fila de UN programa dentro de Discovery Kids Launcher (reemplaza a
    item_program_config.xml, que ahora vive — con otro contenido — como
    activity_program_config.xml, una sola vez por pantalla en vez de
    inflado por fila). Se infla dinámicamente una vez por programa (hasta
    24) — ver DiscoveryKidsLauncherActivity.rebuildProgramList().

    Solo tiene lo que es "el programa" en sí: título, video elegido (SAF), y
    un botón "⚙️ Opciones" que abre ProgramConfigActivity para ESE programa
    puntual (ya_regresa, continuamos, Intro, Créditos, A continuación
    personalizado, activar comerciales — ver esa Activity).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/txtProgramTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Programa 1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:fontFamily="@font/dk_font" />

            <TextView
                android:id="@+id/txtProgramVideoStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin video elegido"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:fontFamily="@font/dk_font"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/btnPickProgramVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="4dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_video_pick"
                    android:contentDescription="Elegir video" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Elegir video del programa"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="14sp"
                    android:fontFamily="@font/dk_font" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnProgramOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/btn_settings"
                android:contentDescription="Opciones del programa" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opciones"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:fontFamily="@font/dk_font"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" />

</LinearLayout>
