<!--
    activity_program_config.xml — Release 5.5.0, reescrita en la 5.6.0

    BUG FIX (malentendido de arquitectura, revertido): la 5.5.0 había
    convertido esta pantalla en una lista de TODOS los programas (cantidad +
    video de cada uno + sus opciones) más los ScreenBugs de eventos —
    equivocado, eso movió "los programas" (que van en el Launcher) para acá.

    Ahora esta pantalla es SOLO las OPCIONES de UN programa puntual (el que
    el usuario tocó "⚙️ Opciones" en su fila, dentro del Launcher — ver
    ProgramConfigActivity.EXTRA_PROGRAM_INDEX). Cada programa tiene sus
    propias opciones, completamente independientes de las de los demás
    programas — cambiar esto acá para el Programa 1 no afecta al Programa 2
    ni a ningún otro.

    Contenido, todo por ATTR_PROGRAM_INDEX (mismo criterio Material3 que el
    resto de la app):
      - ya_regresa personalizado
      - continuamos personalizado
      - Intro (sin default de fábrica)
      - Créditos (sin default de fábrica)
      - A continuación personalizado (antes "NextProgram personalizado" —
        renombrado en la 5.6.0 para que coincida con lo que el usuario ve en
        pantalla durante la transmisión)
      - Activar comerciales (Release 5.6.0, NUEVO — switch simple, sin Uri
        asociada, Predeterminado: activado)
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/programConfigRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/txtProgramConfigSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estas opciones son independientes de las de los demás programas."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:fontFamily="@font/dk_font"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp" />

        <!-- ── Episodios (Release 5.8.0, NUEVO) ──────────────────────────────
             Un programa puede tener varios videos (episodios) en vez de uno
             solo. Al terminar un episodio que no es el último, se muestra un
             corte comercial (igual que entre programas) y arranca el
             siguiente episodio desde cero. Al terminar el ÚLTIMO episodio,
             sigue el flujo normal (Créditos, si están configurados). Ver
             ProgramConfigActivity.bindEpisodes() / LiveDiscoveryKids.
             onProgramSegmentFinished()/resumeProgramAfterCommercial(). -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Episodios"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/dk_font"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elegí uno o más videos para este programa. Entre episodios se muestran los comerciales; al terminar el último, los Créditos. Cada video debe durar al menos 1 minuto."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:fontFamily="@font/dk_font"
            android:lineSpacingExtra="3dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp" />

        <!-- Filas de episodios: se agregan acá en código, una por episodio
             (item_episode_row.xml) — ver ProgramConfigActivity.bindEpisodes(). -->
        <LinearLayout
            android:id="@+id/containerEpisodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp" />

        <TextView
            android:id="@+id/btnAddEpisode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Agregar episodio"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/dk_font"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="20dp" />

        <!-- ── Activar comerciales (Release 5.6.0, NUEVO) ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            app:cardElevation="1dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activar comerciales"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:fontFamily="@font/dk_font" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Desactivado, este programa se reproduce de punta a punta sin cortes (Predeterminado: Activado)"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:fontFamily="@font/dk_font"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchCommercialsEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Preview 2013.6.0.0.2 — "Ya regresa" ELIMINADO por completo (ver
             LiveDiscoveryKids.kt / SettingsManager.kt / ProgramConfigActivity.kt) -->

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" />

        <!-- ── Continuamos: Predeterminado / Personalizado ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Continuamos personalizado"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:fontFamily="@font/dk_font" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchContinuamosCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPickContinuamosVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="18dp"
            android:paddingEnd="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_video_pick"
                android:contentDescription="Elegir continuamos" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Elegir video de continuamos"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/dk_font" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" />

        <!-- ── Intro: sin video predeterminado (Release 5.4.0) ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Intro (después del bumper, antes del programa)"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:fontFamily="@font/dk_font" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchIntroEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtIntroVideoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sin video elegido"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:fontFamily="@font/dk_font"
            android:visibility="gone"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:id="@+id/btnPickIntroVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="18dp"
            android:paddingEnd="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_video_pick"
                android:contentDescription="Elegir intro" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Elegir video de intro"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/dk_font" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" />

        <!-- ── Créditos: sin video predeterminado (Release 5.4.0) ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Créditos (al finalizar el programa)"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:fontFamily="@font/dk_font" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchCreditosEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCreditosVideoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sin video elegido"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:fontFamily="@font/dk_font"
            android:visibility="gone"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:id="@+id/btnPickCreditosVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="18dp"
            android:paddingEnd="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_video_pick"
                android:contentDescription="Elegir créditos" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Elegir video de créditos"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/dk_font" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" />

        <!-- ── A continuación personalizado (Release 5.5.0 — antes "NextProgram
             personalizado", renombrado en la 5.6.0) — SÍ tiene default de fábrica ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="A continuación personalizado"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:fontFamily="@font/dk_font" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchNextProgramCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPickNextProgramImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="18dp"
            android:paddingEnd="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_video_pick"
                android:contentDescription="Elegir imagen de A continuación" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Elegir imagen/GIF de A continuación"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/dk_font" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
