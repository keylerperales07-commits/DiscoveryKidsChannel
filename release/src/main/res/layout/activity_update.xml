<!--
    activity_update.xml — Release 2007.4.4.0

    Layout único para UpdateActivity. Un solo bloque centrado que cubre
    todos los estados de la pantalla (chequeando, al día, disponible,
    descargando, instalando, error) — UpdateActivity.kt alterna la
    visibilidad de cada vista según el estado actual, sin inflar layouts
    distintos ni usar un ViewFlipper.

    Release 2007.4.4.0 — REDISEÑO: se alinea visualmente con el estilo de
    SettingsTheme / activity_settings.xml (lista simple neutra estilo
    Android Settings) en vez del diseño genérico anterior: mismo header
    (botón Atrás + título 24sp), ícono de actualización centrado, y la
    barra de descarga ahora se ve como la pantalla nativa de Android de
    "Actualización del sistema" — porcentaje grande arriba de la barra,
    tamaño descargado/total debajo, y botones planos (sin relleno) en vez
    de los Button de ancho completo de antes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dk_bg"
    android:orientation="vertical">

    <!-- Barra superior: mismo patrón que activity_settings (botón Atrás + título). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/btnUpdateBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Actualizaciones"
            android:textColor="@color/dk_text_primary"
            android:textSize="24sp"
            android:fontFamily="@font/googlesans" />
    </LinearLayout>

    <!-- Contenido centrado: ícono, título, mensaje, progreso, botones. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:id="@+id/imgUpdateIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/ic_update"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtUpdateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dk_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/googlesans"
            android:gravity="center"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/txtUpdateMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/dk_text_secondary"
            android:textSize="15sp"
            android:fontFamily="@font/googlesans"
            android:gravity="center"
            tools:ignore="HardcodedText" />

        <!-- Estado CHECKING: spinner indeterminado (nativo de Android). -->
        <ProgressBar
            android:id="@+id/progressIndeterminate"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:indeterminateTint="@color/dk_accent"
            android:visibility="gone" />

        <!-- Estado DOWNLOADING: porcentaje grande + barra determinada + tamaño. -->
        <LinearLayout
            android:id="@+id/groupDownloadProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtUpdatePercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dk_text_primary"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="@font/googlesans"
                tools:ignore="HardcodedText" />

            <ProgressBar
                android:id="@+id/progressDownload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/dk_accent"
                android:progressBackgroundTint="@color/dk_stroke" />

            <TextView
                android:id="@+id/txtUpdateBytes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/dk_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/googlesans"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Botones planos, estilo diálogo de Android: Secundario a la izquierda,
             Primario (acento) a la derecha — reemplaza los Button de ancho
             completo del diseño anterior. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginTop="32dp">

            <Button
                android:id="@+id/btnUpdateSecondary"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackground"
                android:textColor="@color/dk_text_secondary"
                android:textAllCaps="false"
                android:fontFamily="@font/googlesans"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btnUpdatePrimary"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:textColor="@color/dk_accent"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:fontFamily="@font/googlesans"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
