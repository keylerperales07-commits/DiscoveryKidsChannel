<!--
    activity_update.xml — Release 2007.4.3.0

    Layout único para UpdateActivity. Un solo bloque centrado que cubre
    todos los estados de la pantalla (chequeando, al día, disponible,
    descargando, instalando, error) — UpdateActivity.kt alterna la
    visibilidad de cada vista según el estado actual, sin inflar layouts
    distintos ni usar un ViewFlipper.

    Sigue el mismo lenguaje visual que activity_settings.xml: fondo
    dk_background, texto principal dk_text_primary, texto secundario
    dk_text_secondary, mismo SettingsTheme.

    NOTA PARA KEYLER: si tu activity_settings.xml usa otros nombres de color
    o un ImageButton/drawable distinto para el botón Atrás, ajustá las
    referencias @color/@drawable de este archivo para que coincidan
    (no tengo acceso a tu activity_settings.xml ni a colors.xml reales,
    así que repliqué los nombres que aparecen en SettingsActivity.kt).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dk_bg"
    android:orientation="vertical">

    <!-- Barra superior simple, mismo patrón que activity_settings (botón Atrás). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnUpdateBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Actualizaciones"
            android:textColor="@color/dk_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contenido centrado: título, mensaje, progreso, botones. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/txtUpdateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dk_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/txtUpdateMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/dk_text_secondary"
            android:textSize="15sp"
            android:gravity="center"
            tools:ignore="HardcodedText" />

        <!-- Estado CHECKING: spinner indeterminado. -->
        <ProgressBar
            android:id="@+id/progressIndeterminate"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <!-- Estado DOWNLOADING: barra de progreso determinada + porcentaje. -->
        <ProgressBar
            android:id="@+id/progressDownload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtUpdatePercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/dk_text_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnUpdatePrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:visibility="gone"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnUpdateSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            android:textColor="@color/dk_text_secondary"
            android:visibility="gone"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</LinearLayout>
