<!--
    activity_program_config.xml — Release 5.5.0

    Extraído de activity_launcher.xml: antes la sección "Programas" (cantidad
    + una fila por programa) vivía inline en el Discovery Kids Launcher. Pasa
    a ser su propia Activity (ProgramConfigActivity), accesible desde un
    botón en el Launcher — mismo criterio visual (Material3, MaterialCardView,
    ?attr/color*) que ya usaba esa sección.

    Nuevo en esta Release: sección "ScreenBugs de Eventos" (Navidad, Año
    Nuevo, Pascua, Día de la Tierra) — activar/desactivar cada uno, global
    (no por programa).
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elegí el video de cada programa (ya no hace falta renombrarlo ni copiarlo a Videos), personalizá su ya_regresa, continuamos, Intro, Créditos y NextProgram."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:fontFamily="@font/dk_font"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp" />

        <!-- Item: Cantidad de programas (valor, abre diálogo 1–24) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            app:cardElevation="1dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant">

            <LinearLayout
                android:id="@+id/itemProgramCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cantidad de programas"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="17sp"
                    android:fontFamily="@font/dk_font" />

                <TextView
                    android:id="@+id/txtProgramCountValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 de 24 programas (Predeterminado: 4)"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:fontFamily="@font/dk_font"
                    android:layout_marginTop="2dp"
                    android:alpha="0.8" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══ Sección: ScreenBugs de Eventos (Release 5.5.0) ══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ScreenBugs de eventos"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/dk_font"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reemplazan el ScreenBug normal automáticamente en su fecha, si están activados."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:fontFamily="@font/dk_font"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            app:cardElevation="1dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Navidad (1 al 24 de diciembre)"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:fontFamily="@font/dk_font" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEventNavidad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Año Nuevo (25 de diciembre al 7 de enero)"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:fontFamily="@font/dk_font" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEventAnioNuevo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pascua (Domingo de Pascua)"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:fontFamily="@font/dk_font" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEventPascua"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Día de la Tierra (22 de abril)"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:fontFamily="@font/dk_font" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEventTierra"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══ Sección: Programas ══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Programas"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/dk_font"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- Filas de programas: se agregan acá en código, una por programa
             (item_program_config.xml), ver rebuildProgramList(). -->
        <LinearLayout
            android:id="@+id/containerPrograms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
