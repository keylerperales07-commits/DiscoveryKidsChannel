<!--
    activity_launcher.xml — Release 2009.5.1.0 ("Parque Imaginario"), 2009.5.2.1

    Rediseño a Material Design 3 puro:
      - Ya no hay un MenuBar custom (LinearLayout con degradado + logo +
        título hecho a mano) — la Activity ahora declara la ActionBar
        ORIGINAL de Android (Theme.Material3.DayNight, no NoActionBar — ver
        themes.xml). Release 2009.5.2.1: la ActionBar solo tiene el título
        (puesto por código en DiscoveryKidsLauncherActivity.onCreate()) — el
        logo se sacó de ahí y ahora vive en el cuerpo de la pantalla, entre
        la ActionBar y el botón "Iniciar canal" (ver @+id/imgLauncherLogo
        acá abajo). El botón de Configuración vive en el menú de overflow
        original de Android (menu_launcher.xml), no como ícono fijo.
      - "Iniciar canal" ahora es un MaterialButton relleno (estilo M3).
      - La fila de "Cantidad de programas" vive dentro de un
        MaterialCardView (elevación M3 estándar).
      - Colores: todo por atributos de tema (?attr/colorSurface,
        ?attr/colorOnSurface, etc.) en vez de los dk_* fijos — así el
        Launcher sigue el esquema claro/oscuro automáticamente (ver
        values/colors.xml y values-night/colors.xml).
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Logo — Release 2009.5.2.1: antes vivía en la ActionBar
             (setIcon/setDisplayUseLogoEnabled); ahora va acá, en el cuerpo,
             entre la ActionBar (que solo tiene el título) y el botón
             "Iniciar canal". -->
        <ImageView
            android:id="@+id/imgLauncherLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:contentDescription="Discovery Kids"
            android:src="@drawable/icon" />

        <!-- Botón principal: Iniciar canal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartChannel"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Iniciar canal"
            android:textSize="16sp"
            android:fontFamily="@font/dk_font"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart" />

        <!-- Release 5.5.0 — la sección "Programas" (cantidad + una fila por
             programa, ya_regresa/continuamos/Intro/Créditos/NextProgram
             personalizados) se extrajo a su propia Activity
             (ProgramConfigActivity) — acá solo queda el botón que la abre. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProgramConfig"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Configuración de Programa"
            android:textSize="16sp"
            android:fontFamily="@font/dk_font"
            app:icon="@drawable/ic_video_pick"
            app:iconGravity="textStart" />

    </LinearLayout>
</ScrollView>
