<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ══ Paleta SettingsActivity (Preview 2006.4.1.0.12) ══
         Rediseño a lista simple neutra estilo Android Settings / AndroidIDE
         (antes: menú OSD verde fósforo). Sin acento de color en los controles;
         solo escala de grises sobre fondo casi negro. -->
    <color name="dk_bg">#121212</color>
    <color name="dk_stroke">#2A2A2A</color>
    <color name="dk_text_primary">#F2F2F2</color>
    <color name="dk_text_secondary">#9AA0A6</color>
    <color name="dk_accent">#8AB4F8</color>

    <!-- ══ Discovery Kids Launcher (Release 2009.5.0.0) ══
         MenuBar superior: degradado azul (arriba) → cian (abajo), logo +
         título en dk_font. Ver bg_launcher_menubar.xml y activity_launcher.xml.
         (Release 2009.5.1.0: el MenuBar custom se reemplazó por la ActionBar
         original de Android + Material Design 3 — ver más abajo. Este
         degradado ya no se usa en el Launcher, se deja por compatibilidad.) -->
    <color name="dk_launcher_gradient_top">#1565C0</color>
    <color name="dk_launcher_gradient_bottom">#00BCD4</color>

    <!-- ══ Rediseño Discovery Kids Launcher — Preview 2013.6.0.0.3 ══
         Vuelve a la estética del sitio web clásico de Discovery Kids
         Latinoamérica (referencia visual entregada por Keyler): franja verde
         curva arriba con el logo "DK" + fila de personajes, panel de
         contenido blanco/crema redondeado, acentos amarillos. El fondo
         (detrás de todo) cambia según el horario real del dispositivo — ver
         DiscoveryKidsLauncherActivity.applyTimeOfDayTheme(): mañana (celeste),
         tarde (anaranjado) y noche (violeta). Estos son degradados de
         respaldo con los mismos colores del sitio de referencia — si Keyler
         agrega los fondos ilustrados reales (bg_launcher_manana.webp/
         bg_launcher_tarde.webp/bg_launcher_noche.webp en res/drawable), esos
         reemplazan a los degradados automáticamente (ver
         launcher_bg_manana.xml/tarde/noche.xml, que son solo un <bitmap>
         envolviendo cada webp si existe, con el degradado como fallback si
         el bitmap no está). -->
    <color name="dk_launcher_header_green">#7CB342</color>
    <color name="dk_launcher_header_green_dark">#558B2F</color>
    <color name="dk_launcher_yellow">#FFD500</color>
    <color name="dk_launcher_yellow_dark">#F9A825</color>
    <color name="dk_launcher_panel_bg">#F5EBD9</color>
    <color name="dk_launcher_text_on_green">#1B3B0F</color>

    <color name="dk_launcher_manana_top">#8FD3F4</color>
    <color name="dk_launcher_manana_bottom">#A8E6CF</color>
    <color name="dk_launcher_tarde_top">#F6C453</color>
    <color name="dk_launcher_tarde_bottom">#E0883A</color>
    <color name="dk_launcher_noche_top">#3B2265</color>
    <color name="dk_launcher_noche_bottom">#7A4FA3</color>

    <!-- ══ Material Design 3 — Discovery Kids Launcher (Release 2009.5.1.0) ══
         Esquema CLARO. Semilla: el azul ya usado en la app (#1565C0, el
         mismo del degradado del menubar anterior), con el cian del propio
         degradado como "secondary". Ver values-night/colors.xml para la
         versión oscura (mismos nombres, el sistema elige automáticamente
         según el tema del dispositivo — DayNight). -->
    <color name="md3_primary">#0061A4</color>
    <color name="md3_on_primary">#FFFFFF</color>
    <color name="md3_primary_container">#D1E4FF</color>
    <color name="md3_on_primary_container">#001D36</color>

    <color name="md3_secondary">#00658E</color>
    <color name="md3_on_secondary">#FFFFFF</color>
    <color name="md3_secondary_container">#C2E8FF</color>
    <color name="md3_on_secondary_container">#001E2C</color>

    <color name="md3_background">#FDFCFF</color>
    <color name="md3_on_background">#1A1C1E</color>
    <color name="md3_surface">#FDFCFF</color>
    <color name="md3_on_surface">#1A1C1E</color>
    <color name="md3_surface_variant">#DFE2EB</color>
    <color name="md3_on_surface_variant">#43474E</color>
    <color name="md3_outline">#73777F</color>
    <color name="md3_outline_variant">#C3C7CF</color>
</resources>
