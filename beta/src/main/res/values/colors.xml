         solo escala de grises sobre fondo casi negro. -->
    <color name="dk_bg">#121212</color>
    <color name="dk_stroke">#2A2A2A</color>
    <color name="dk_text_primary">#F2F2F2</color>
    <color name="dk_text_secondary">#9AA0A6</color>
    <color name="dk_accent">#8AB4F8</color>

    <!-- ══ Discovery Kids Launcher (Release 2009.5.0.0) ══
         MenuBar superior: degradado azul (arriba) → cian (abajo), logo +
         título en dk_font. Ver bg_launcher_menubar.xml y activity_launcher.xml.
         (Release 2009.5.1.0: el MenuBar custom se reemplazó por la ActionBar
         original de Android + Material Design 3 — ver más abajo. Este
         degradado ya no se usa en el Launcher, se deja por compatibilidad.) -->
    <color name="dk_launcher_gradient_top">#1565C0</color>
    <color name="dk_launcher_gradient_bottom">#00BCD4</color>

