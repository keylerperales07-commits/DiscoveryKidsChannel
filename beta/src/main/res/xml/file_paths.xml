<?xml version="1.0" encoding="utf-8"?>
<!--
    file_paths.xml — Preview 2006.4.2.0.20

    Rutas expuestas por el FileProvider de AppUpdater. El .apk se descarga
    con DownloadManager hacia getExternalFilesDir(DIRECTORY_DOWNLOADS), que
    en disco corresponde a .../Android/data/<package>/files/Download — de
    ahí "external-files-path" con subdirectorio "Download".
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path
        name="updates"
        path="Download/" />
</paths>
