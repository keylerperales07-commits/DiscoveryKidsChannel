<?xml version="1.0" encoding="utf-8"?>

<manifest 
    xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Storage permission for reading user programs from Movies folder -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Keep screen on while playing -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Preview 2006.4.2.0.20: Actualizador — consulta GitHub Releases y descarga el .apk -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    
    <application 
        android:allowBackup="true" 
        android:icon="@mipmap/ic_launcher_preview"
        android:roundIcon="@mipmap/ic_launcher_round_preview"
        android:label="@string/beta_app_name" 
        android:supportsRtl="true" 
        android:theme="@style/AppTheme">
        <!-- Release 2009.5.0.0: ya no es la Activity de inicio (intent-filter
             MAIN/LAUNCHER se movió a DiscoveryKidsLauncherActivity, más abajo).
             Sigue exported=true porque se sigue lanzando con un Intent
             explícito desde esa Activity (y desde SettingsActivity, al
             reiniciar tras cambiar Experimental). -->
        <activity 
            android:name="LiveDiscoveryKids" 
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="stateHidden">
        </activity>

        <!-- Preview 2006.4.1.0.11: pantalla de Configuración (música, debug, brillo CRT) -->
        <activity
            android:name="SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/SettingsTheme"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />
        
        <activity 
            android:name=".UpdateActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/SettingsTheme"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <!-- Release 5.5.0: extraída de DiscoveryKidsLauncherActivity — antes
             la sección "Programas" vivía inline ahí. Accesible desde un
             botón en el Launcher (nunca directamente, exported=false).
             LauncherTheme, mismo criterio visual M3 que ya usaba esa
             sección. -->
        <activity
            android:name=".ProgramConfigActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/LauncherTheme"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <!-- Release 2009.5.0.0: Discovery Kids Launcher pasa a ser la Activity
             de inicio REAL de la app (intent-filter MAIN/LAUNCHER movido acá
             desde LiveDiscoveryKids). Con Experimental desactivado (default),
             redirige de inmediato a LiveDiscoveryKids sin mostrar nada — ver
             DiscoveryKidsLauncherActivity.onCreate(). Portrait, LauncherTheme
             (dk_font) — antes (Release 4.6.0) era exported=false y usaba
             SettingsTheme, porque era una pantalla secundaria abierta solo
             desde Configuración.

             Preview 2013.6.0.0.3 — el intent-filter MAIN/LAUNCHER que estaba
             ACÁ se movió a los dos <activity-alias> de abajo (icono_manana/
             icono_tarde_noche): esta <activity> real ya NO tiene
             intent-filter propio ni ícono propio — el ícono que ve el
             usuario en el launcher del sistema lo define cuál de los dos
             alias está enabled en cada momento (uno solo a la vez — ver
             DiscoveryKidsLauncherActivity.applyTimeOfDayIcon(), que llama
             PackageManager.setComponentEnabledSetting() al arrancar). -->
        <activity 
            android:name=".DiscoveryKidsLauncherActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/LauncherTheme"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <!-- Preview 2013.6.0.0.3 — ícono de MAÑANA (00:00–11:59): el
             ic_launcher/ic_launcher_round "de fábrica" de siempre. Habilitado
             por defecto (android:enabled="true") — es el estado con el que
             arranca una instalación nueva, antes de que el código llegue a
             decidir cuál corresponde según la hora real. -->
        <activity-alias
            android:name=".LauncherIconManana"
            android:targetActivity=".DiscoveryKidsLauncherActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_preview"
            android:roundIcon="@mipmap/ic_launcher_round_preview"
            android:label="@string/beta_app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Preview 2013.6.0.0.3 — ícono de TARDE Y NOCHE (12:00–23:59): el
             de tarde aplica también para la noche (pedido explícito de
             Keyler — no hay un tercer set de íconos). Deshabilitado por
             defecto; se habilita por código junto con deshabilitar el de
             arriba, nunca los dos habilitados a la vez. -->
        <activity-alias
            android:name=".LauncherIconTardeNoche"
            android:targetActivity=".DiscoveryKidsLauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_preview_tarde"
            android:roundIcon="@mipmap/ic_launcher_round_preview_tarde"
            android:label="@string/beta_app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Preview 2006.4.2.0.20: FileProvider para que AppUpdater pueda exponer
             el .apk descargado (carpeta privada de la app) al instalador del
             sistema sin usar URIs file:// directas (prohibidas desde Android 7). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>