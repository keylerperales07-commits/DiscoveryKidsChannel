<resources>
    <!-- Full-screen, no action bar, black background -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:fontFamily">@font/googlesans</item>
    </style>

    <!-- ══ SettingsActivity (Preview 2006.4.1.0.11) ══
         Mismo lenguaje fullscreen/negro que AppTheme, pero sin FLAG_FULLSCREEN
         forzado en código: es una pantalla de menú, no el canal en vivo. -->
    <style name="SettingsTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/dk_bg</item>
        <item name="android:statusBarColor">@color/dk_bg</item>
        <item name="android:navigationBarColor">@color/dk_bg</item>
        <item name="android:fontFamily">@font/googlesans</item>
        <item name="colorAccent">@color/dk_phosphor_green</item>
    </style>

    <!-- Tema aplicado a cada SwitchCompat para que su thumb/track usen
         el verde fósforo de marca en vez del azul Material por defecto. -->
    <style name="SettingsSwitchTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="colorControlActivated">@color/dk_phosphor_green</item>
        <item name="colorSwitchThumbNormal">@color/dk_text_secondary</item>
        <item name="android:colorForeground">@color/dk_stroke</item>
    </style>
</resources>
