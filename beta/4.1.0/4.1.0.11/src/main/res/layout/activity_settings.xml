<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_settings.xml — Preview 2006.4.1.0.11

    Lenguaje visual: menú OSD ("On-Screen Display") de un televisor CRT de
    configuración — no Material Design genérico. Fondo casi negro, acento
    verde fósforo P1 (el mismo lenguaje del CrtOverlayView), tipografía
    monoespaciada para los rótulos de sección (como un menú de TV real) y
    googlesans para el texto descriptivo, consistente con el resto de la app.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings_screen"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ══ Header ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back"
                android:contentDescription="Volver" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONFIGURACIÓN"
                    android:textColor="@color/dk_phosphor_green"
                    android:textSize="20sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Discovery Kids LA · Canal de configuración"
                    android:textColor="@color/dk_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/googlesans"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dk_stroke"
            android:layout_marginBottom="20dp" />

        <!-- ══ Selector de modo: Completa / Profesional ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODO DE CONFIGURACIÓN"
                android:textColor="@color/dk_text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:fontFamily="monospace"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnModeCompleta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_mode_unselected"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtModeCompletaLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COMPLETA"
                        android:textColor="@color/dk_text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Todas las opciones"
                        android:textColor="@color/dk_text_secondary"
                        android:textSize="10sp"
                        android:fontFamily="@font/googlesans"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnModeProfesional"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_mode_selected"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtModeProfesionalLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROFESIONAL"
                        android:textColor="@color/dk_phosphor_green"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Solo lo esencial"
                        android:textColor="@color/dk_text_secondary"
                        android:textSize="10sp"
                        android:fontFamily="@font/googlesans"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- ══ Sección: General (música) — visible en ambos modos ══ -->
        <LinearLayout
            android:id="@+id/sectionGeneral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GENERAL"
                android:textColor="@color/dk_text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:fontFamily="monospace"
                android:layout_marginBottom="10dp" />

            <!-- Tarjeta: Música de fondo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_settings_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Música de fondo"
                        android:textColor="@color/dk_text_primary"
                        android:textSize="15sp"
                        android:fontFamily="@font/googlesans"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reproduce música ambiental durante los programas"
                        android:textColor="@color/dk_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/googlesans"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchBgMusic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/SettingsSwitchTheme" />
            </LinearLayout>

        </LinearLayout>

        <!-- ══ Sección: Avanzado (visible solo en modo Completa) ══ -->
        <LinearLayout
            android:id="@+id/sectionAvanzado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVANZADO"
                android:textColor="@color/dk_text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:fontFamily="monospace"
                android:layout_marginBottom="10dp" />

            <!-- Tarjeta: Brillo del CRT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_settings_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Brillo del CRT"
                            android:textColor="@color/dk_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="@font/googlesans"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Intensidad del efecto CRT (scanlines, viñeta y parpadeo)"
                            android:textColor="@color/dk_text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="@font/googlesans"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtCrtBrightnessValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="@color/dk_phosphor_green"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekCrtBrightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="@color/dk_phosphor_green"
                    android:thumbTint="@color/dk_phosphor_green" />
            </LinearLayout>

            <!-- Tarjeta: Modo debug -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_settings_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modo debug"
                        android:textColor="@color/dk_text_primary"
                        android:textSize="15sp"
                        android:fontFamily="@font/googlesans"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Muestra FPS, RAM y versión sobre la pantalla"
                        android:textColor="@color/dk_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/googlesans"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDebugMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/SettingsSwitchTheme" />
            </LinearLayout>

        </LinearLayout>

        <!-- ══ Footer: versión ══ -->
        <TextView
            android:id="@+id/txtSettingsVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Discovery Kids LA Preview · v2006.4.1.0.11"
            android:textColor="@color/dk_text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
